      "Name": "Detection IDs",
      "Type": 2,
      "IsMandatory": true,
      "Description": "Comma-separated Vega detection IDs.",
      "DefaultValue": ""
    },
    {
      "Name": "Severity",
      "Type": 2,
      "IsMandatory": false,
      "Description": "Possible Values: LOW, MEDIUM, HIGH, CRITICAL.",
      "DefaultValue": ""
    },
    {
      "Name": "State",
      "Type": 2,
      "IsMandatory": false,
      "Description": "Possible Values: ENABLED, DISABLED, TEST_MODE.",
