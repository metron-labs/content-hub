  "IsEnabled": true,
  "IsCustom": true,
  "AiGenerated": false,
  "IsSystem": false,
  "Version": 1.0,
  "TimeoutSeconds": 600,
  "IsAsync": false,
  "AsyncPollingIntervalInSeconds": 3600,
  "TotalIntervalTimeoutForAsyncInSeconds": 86400,
  "Parameters": [
