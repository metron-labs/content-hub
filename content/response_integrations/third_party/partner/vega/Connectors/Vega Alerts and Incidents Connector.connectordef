      "IsMandatory": false,
      "IsAdvanced": true,
      "DefaultValue": "LOW,MEDIUM,HIGH,CRITICAL",
      "Name": "Alert Severities to Fetch",
      "Type": 14,
      "Mode": 2,
      "Description": "Possible Values: LOW, MEDIUM, HIGH, CRITICAL. Empty = all. Unknown values are ignored."
    },
    {
      "ConnectorDefinitionId": 0,
      "IsMandatory": false,
      "IsAdvanced": true,
      "DefaultValue": "OPEN,IN PROGRESS,PEER REVIEW,RESOLVED",
      "Name": "Alert Statuses to Fetch",
      "Type": 14,
      "Mode": 2,
      "Description": "Possible Values: OPEN, IN PROGRESS, PEER REVIEW, RESOLVED. Empty = all. Unknown values are ignored."
    },
    {
      "ConnectorDefinitionId": 0,
      "IsMandatory": false,
      "IsAdvanced": true,
      "DefaultValue": "MALICIOUS,SUSPICIOUS,BENIGN,INCONCLUSIVE,NA",
      "Name": "Alert Verdicts to Fetch",
      "Type": 14,
      "Mode": 2,
      "Description": "Possible Values: MALICIOUS, SUSPICIOUS, BENIGN, INCONCLUSIVE, NA. Empty = all. Unknown values are ignored."
    },
    {
      "ConnectorDefinitionId": 0,
      "IsMandatory": true,
      "IsAdvanced": false,
      "DefaultValue": "Yes,No",
      "Name": "Has Related Incidents",
      "Type": 14,
      "Mode": 2,
      "Description": "Possible Values: Yes, No. Select both to fetch all alerts. At least one is required."
    },
    {
      "ConnectorDefinitionId": 0,
      "IsMandatory": false,
      "IsAdvanced": true,
      "DefaultValue": "LOW,MEDIUM,HIGH,CRITICAL",
      "Name": "Incident Severities to Fetch",
      "Type": 14,
      "Mode": 2,
      "Description": "Possible Values: LOW, MEDIUM, HIGH, CRITICAL. Empty = all. Unknown values are ignored."
    },
    {
      "ConnectorDefinitionId": 0,
      "IsMandatory": false,
      "IsAdvanced": true,
      "DefaultValue": "NEW,INVESTIGATING,ON HOLD,EXTERNAL ESCALATION,RESOLVED,REOPENED,REVIEW RECOMMENDED,RESPONSE REQUIRED,UNDER REVIEW",
      "Name": "Incident Statuses to Fetch",
      "Type": 14,
      "Mode": 2,
      "Description": "Possible Values: NEW, INVESTIGATING, ON HOLD, EXTERNAL ESCALATION, RESOLVED, REOPENED, REVIEW RECOMMENDED, RESPONSE REQUIRED, UNDER REVIEW. Empty = all. Unknown values are ignored."
    },
    {
      "ConnectorDefinitionId": 0,
