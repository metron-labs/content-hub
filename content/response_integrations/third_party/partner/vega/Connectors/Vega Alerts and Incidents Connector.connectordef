      "DefaultValue": "MALICIOUS,SUSPICIOUS,BENIGN,INCONCLUSIVE,NA",
      "Name": "Incident Verdicts to Fetch",
      "Type": 14,
      "Mode": 2,
      "Description": "Possible Values: MALICIOUS, SUSPICIOUS, BENIGN, INCONCLUSIVE, NA. Empty = all. Unknown values are ignored."
    },
    {
