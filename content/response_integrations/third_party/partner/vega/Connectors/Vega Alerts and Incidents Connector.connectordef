      "DefaultValue": "https://api.vega.io",
      "Name": "API Root",
      "Type": 6,
      "Mode": 2,
      "Description": "The Base URL of the Vega API."
    },
    {
      "ConnectorDefinitionId": 0,
      "IsMandatory": true,
      "IsAdvanced": false,
      "DefaultValue": "",
      "Name": "Access Key ID",
      "Type": 3,
      "Mode": 2,
      "Description": "Vega Access Key ID (X-Vega-Key-Id header)."
    },
    {
